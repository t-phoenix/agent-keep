{
  "name": "@agentkeep/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "canary": "tsx scripts/canary-x402.ts",
    "wallet:create": "tsx scripts/create-canary-wallet.ts",
    "wallet:optin": "tsx scripts/optin-canary-usdc.ts",
    "migrate": "tsx scripts/migrate-neon.ts"
  },
  "dependencies": {
    "@algorandfoundation/algokit-utils": "10.0.0-alpha.46",
    "@hono/node-server": "^1.14.1",
    "@neondatabase/serverless": "^1.1.0",
    "@x402/avm": "^2.27.0",
    "@x402/core": "^2.27.0",
    "@x402/extensions": "^2.27.0",
    "@x402/fetch": "^2.27.0",
    "@x402/hono": "^2.27.0",
    "hono": "^4.7.5",
    "pg": "^8.23.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
