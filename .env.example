# AgentKeep local / deploy — never commit real secrets
# See docs/33-env-and-secrets-matrix.md and docs/40c-easy-free-host-cloudrun.md

PORT=8787
NODE_ENV=development

# Payment (Algorand + GoPlausible) — NOT Avalanche/Base/EVM
# Do not put inline comments after values (use separate # lines)
PAYMENT_FACILITATOR=goplausible
PAYMENT_MODE=testnet
PAYMENT_NETWORK=ALGORAND_Testnet_CAIP2
# Optional override; default is full-hash CAIP-2 matching GoPlausible /supported
# Testnet:  algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI=
# Mainnet:  algorand:wGHE2Pwdvd7S12BL5FaOP20EGYesN73ktiC1qzkkit8=
# PAYMENT_CAIP2=
USDC_ASA_ID=10458941
# Mainnet challenge flip: PAYMENT_MODE=mainnet, PAYMENT_NETWORK=ALGORAND_Mainnet_CAIP2, USDC_ASA_ID=31566704
# Algorand address (58 chars). Avalanche 0x addresses will NOT work for this challenge.
PAYTO_ADDRESS=
FACILITATOR_URL=https://facilitator.goplausible.xyz
PAYMENT_PAUSE=false
# mock = local/CI without chain · live = GoPlausible verify+settle
PAYMENT_ADAPTER=mock

# Challenge
X402_CHALLENGE_TAG=x402-global-challenge

# Local canary only — prefer `pnpm --filter @agentkeep/api wallet:create`
# (writes gitignored `.algorand/canary-wallet.json`). Do NOT commit mnemonics.
# AVM_MNEMONIC=
# CANARY_ADDRESS=

# Session
SESSION_HMAC_SECRET=dev-change-me-to-a-long-random-string

# Caps (minor units, 6 decimals USDC)
DEFAULT_DAILY_CAP_MINOR=2000000

# Public URLs (set after deploy)
# Production API host (Bazaar resource URLs). Marketing site is SITE_URL.
PUBLIC_API_BASE=http://localhost:8787
SITE_URL=https://agentkeep.online
OWNER_WEB_BASE=http://localhost:8787
ARTIFACTS_BASE=

# Neon (pulled by `neon link` / `neon env pull` — do not commit .env)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=production

# Optional R2 (artifacts — H7)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional email / telegram (notify — H7)
# Resend: paste API key into EMAIL_API_KEY; use onboarding@resend.dev until domain verified
EMAIL_API_KEY=
EMAIL_FROM=
TELEGRAM_BOT_TOKEN=

# Multi-route canary (after deploy): CANARY_ROUTES=memory,fetch,receipts,trust,artifacts
# CANARY_NETWORK=mainnet
# CANARY_BASE_URL=https://….run.app

