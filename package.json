    "dev:web": "pnpm --filter @agentkeep/web dev",
    "build:web": "pnpm --filter @agentkeep/web build",
    "dev:api": "pnpm --filter @agentkeep/api dev"
  },
  "dependencies": {
    "@neon/config": "^1.7.2",
    "@neon/env": "^1.4.3"
